# Copier ce fichier en .env et l'adapter (le fichier .env ne doit JAMAIS être versionné)
APP_URL=http://localhost:8000
APP_DEBUG=false

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vite_gourmand
DB_PASSWORD=change-moi
# Chemin du certificat CA si la base exige une connexion TLS (ex : /etc/ssl/certs/ca-certificates.crt)
DB_SSL_CA=

# MongoDB (statistiques)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=vite_gourmand

# SMTP : laisser MAIL_HOST vide en local => les mails sont enregistrés dans storage/mails/
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vite-gourmand.fr
MAIL_ENTREPRISE=contact@vite-gourmand.fr
